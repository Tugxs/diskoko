NODE_ENV=production
BASE_URL=https://YOUR-SERVICE.onrender.com
FRONTEND_URL=https://tugxs.github.io/diskoko
DATABASE_URL=postgresql://...
SESSION_SECRET=generate-a-long-random-value
ENCRYPTION_KEY=generate-another-long-random-value
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
CUSTOMER_GUILD_ID=
CUSTOMER_ROLE_ID=
STARTER_ROLE_ID=
GROWTH_ROLE_ID=
BUSINESS_ROLE_ID=
ADMIN_DISCORD_IDS=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=support@diskoko.com
SMTP_PASS=
SMTP_FROM=diskoko <support@diskoko.com>
# Soft database admission limit in MiB; review when database disk capacity changes.
RESOURCE_DB_SOFT_LIMIT_MB=700
# Remote connections verify certificates. Private Render TLS needs a trusted leaf pin.
DB_TLS_MODE=verify
DB_TLS_CA=
DB_TLS_PIN_HOST=
DB_WEB_POOL_MAX=8
DB_WORKER_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=120000
# Use external after the reviewed owner migration and runtime-role grants are applied.
DB_SCHEMA_MODE=startup
